# Environment Variables for Streamlit CRE Dashboard
# Copy this file to .env and add your actual API keys
# DO NOT commit .env to git!

# FRED API Key - Get yours free at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your-fred-api-key-here

# NYC OpenData App Token - Get yours free at https://data.cityofnewyork.us/
NYC_OPENDATA_APP_TOKEN=your-nyc-token-here

# Snowflake credentials (for future use)
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
